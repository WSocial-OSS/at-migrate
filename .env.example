# Host of the W PDS. Confirmed against the live network: a W account
# (anna.wsocial.eu) resolves to https://pds.wsocial.network, which serves
# .wsocial.eu handles and is invite-only.
#
# Note this is NOT wsocial.news — that is the marketing site, not a PDS.
# api.wsocial.eu and bsky.wsocial.eu are aliases of the same server;
# pds.wsocial.eu currently returns 503. Use the canonical host, which is the
# one that matches the server's own DID (did:web:pds.wsocial.network).
WSOCIAL_PDS_HOST=pds.wsocial.network

# Optional pin. When set, EuroSky is offered ahead of the live directory.
# eurosky.social is a live PDS (did:web:eurosky.social).
EUROSKY_PDS_HOST=

# Optional extra hosts offered in the direction picker, comma separated.
# Format: Label|hostname
EXTRA_PDS_HOSTS=

# Optional. Primary relay for the live host directory (com.atproto.sync.listHosts).
# Defaults to relay1.us-west.bsky.network.
# ATPROTO_RELAY_HOST=

# Optional. Used only when the primary relay fails and there is no cache.
# Defaults to relay1.us-east.bsky.network.
# ATPROTO_RELAY_FALLBACK=
