# Host of the WSocial PDS. Confirm this before shipping — it is the one value
# that cannot be guessed, and the app validates it with com.atproto.server.describeServer
# on first load, so a wrong value shows up immediately as "not a PDS".
WSOCIAL_PDS_HOST=wsocial.example

# Optional: signup invite code required by the WSocial PDS, if it runs invite-only.
# Users can also paste their own code in the wizard.
WSOCIAL_INVITE_CODE=

# Optional extra hosts offered in the direction picker, comma separated.
# Format: Label|hostname
EXTRA_PDS_HOSTS=
