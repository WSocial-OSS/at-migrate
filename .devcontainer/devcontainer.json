{
  "name": "at-migrate",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3210],
  "portsAttributes": {
    "3210": {
      "label": "wizard",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install",
  "postStartCommand": "cp -n .env.example .env.local || true",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
